# ROAM mobile — copy to .env for local development (never commit .env). Expo reads EXPO_PUBLIC_* at bundle
# time: restart `expo start` (with --clear) after a change. These values are public (they end up in the
# app bundle): never put a secret here. See mobiledocs/MOBILE_API_INTEGRATION.md.

# Where the data comes from: mock (default, in-app mock repositories) | api (the ROAM API).
EXPO_PUBLIC_DATA_SOURCE=mock

# The ROAM API origin, without /api/v1. Required when EXPO_PUBLIC_DATA_SOURCE=api.
#   iOS simulator:     http://localhost:3000
#   Android emulator:  http://10.0.2.2:3000
#   Physical device:   http://<your computer's LAN IP>:3000  (same Wi-Fi; do not commit it)
EXPO_PUBLIC_API_URL=
