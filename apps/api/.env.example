# ROAM API — copy to .env for local development (never commit .env).
# Placeholders only: no real secret belongs in this file.

# development | test | production
NODE_ENV=development
PORT=3000

# PostgreSQL connection string (required): the development database. URL-encode special characters of the
# password. Unit tests do not need it; without a reachable database the API still starts outside production
# and /health/database reports it.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/roam?schema=public

# Database integration tests only (pnpm test:db): a dedicated database, emptied by the tests. Its name must
# end with _test and differ from DATABASE_URL, or the tests refuse to run. Not read by the API.
DATABASE_TEST_URL=postgresql://USER:PASSWORD@localhost:5432/roam_test?schema=public

# Browser origins allowed by CORS, comma-separated (Expo web in development). Native mobile apps
# are not affected by CORS. Leave empty to allow none.
CORS_ORIGINS=http://localhost:8081

# error | warn | log | debug | verbose (default: debug in development, log in production)
LOG_LEVEL=
# Swagger UI on /docs (default: on outside production)
SWAGGER_ENABLED=

# Future providers (Data Foundation) — not used yet
GOOGLE_PLACES_API_KEY=
TICKETMASTER_API_KEY=

# Authentication (apidocs/AUTHENTICATION.md): session lifetime in days, 1–365 (default 30). Sessions are
# opaque tokens stored hashed in PostgreSQL: there is no signing secret to configure.
AUTH_SESSION_TTL_DAYS=
