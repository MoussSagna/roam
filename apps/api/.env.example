# ROAM API — copy to .env for local development (never commit .env).
# Placeholders only: no real secret belongs in this file.

# development | test | production
NODE_ENV=development
PORT=3000

# PostgreSQL connection string (required): the development database. URL-encode special characters of the
# password. Unit tests do not need it; without a reachable database the API still starts outside production
# and /health/database reports it.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/roam?schema=public

# Database integration tests only (pnpm test:db): a dedicated database, emptied by the tests. Its name must
# end with _test and differ from DATABASE_URL, or the tests refuse to run. Not read by the API.
DATABASE_TEST_URL=postgresql://USER:PASSWORD@localhost:5432/roam_test?schema=public

# Browser origins allowed by CORS, comma-separated (Expo web in development). Native mobile apps
# are not affected by CORS. Leave empty to allow none.
CORS_ORIGINS=http://localhost:8081

# error | warn | log | debug | verbose (default: debug in development, log in production)
LOG_LEVEL=
# Swagger UI on /docs (default: on outside production)
SWAGGER_ENABLED=

# Providers (Data Foundation). Backend only: never in the mobile app, never in an EXPO_PUBLIC_* variable.
# Google Places API (New) key (apidocs/GOOGLE_PLACES_PROVIDER.md), restricted to the Places API (New). Optional:
# the API starts without it; the Google Places adapter then refuses to run (no request is sent).
GOOGLE_PLACES_API_KEY=
# Geoapify Places API key (apidocs/GEOAPIFY_PROVIDER.md). Optional, same rules: without it the Geoapify adapter
# refuses to run (no request is sent).
GEOAPIFY_API_KEY=
# Ticketmaster (DATA-3) — not used yet
TICKETMASTER_API_KEY=

# Authentication (apidocs/AUTHENTICATION.md): session lifetime in days, 1–365 (default 30). Sessions are
# opaque tokens stored hashed in PostgreSQL: there is no signing secret to configure.
AUTH_SESSION_TTL_DAYS=

# Rate limiting (apidocs/RATE_LIMITING.md): counters in the API process's memory (one instance; reset on restart).
# Leave empty for the defaults. RATE_LIMIT_ENABLED=false turns every limit off (not recommended).
RATE_LIMIT_ENABLED=
# Every request, per client IP (default 300 per 60 s).
RATE_LIMIT_IP_LIMIT=
RATE_LIMIT_IP_TTL_SECONDS=
# Every request, per session (bearer token) or per IP without one (default 120 per 60 s).
RATE_LIMIT_CLIENT_LIMIT=
RATE_LIMIT_CLIENT_TTL_SECONDS=
# Login, register and password reset together, per IP (default 10 per 900 s, then blocked 900 s).
RATE_LIMIT_AUTH_LIMIT=
RATE_LIMIT_AUTH_TTL_SECONDS=
# Writes (POST, PATCH, PUT, DELETE) outside the auth routes, per session or IP (default 30 per 60 s).
RATE_LIMIT_MUTATION_LIMIT=
RATE_LIMIT_MUTATION_TTL_SECONDS=

# Reverse proxies in front of the API whose X-Forwarded-For is trusted (number of hops; default 0 = none).
TRUST_PROXY=
